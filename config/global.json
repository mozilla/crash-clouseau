{
    "products":
    [
        "Firefox"
    ],
    "channels":
    [
        "nightly",
        "beta",
        "release"
    ],
    "facets_limit": 10000,
    "backward_lookup_ndays": 3,
    "max_ndays": 30,
    "score":
    {
        "max": 10,
        "number_of_lines": 5
    },
    "thresholds":
    {
        "installs":
        {
            "Firefox":
            {
                "nightly": 1,
                "beta": 6,
                "release": 50
            }
        },
        "protos":
        {
            "Firefox":
            {
                "nightly": 50,
                "beta": 20,
                "release": 20
            }
        }
    },
    "agent":
    {
        "schema_version": 1,
        "min_citations_per_claim": 1,
        "abstain_below_confidence": 0.85,
        "enabled": true,
        "queue": "agent",
        "job_timeout": 1800,
        "skip_if_existing": true,
        "max_seed_frames": 40,
        "agent_version": 1,
        "ui":
        {
            "show_abstain": false,
            "high_confidence_label": "STRONG EVIDENCE"
        },
        "confidence":
        {
            "apply_min": 85
        },
        "apply":
        {
            "enabled_types": ["bugzilla.add_comment", "bugzilla.update_bug"]
        },
        "patch_extraction":
        {
            "diff_byte_cap": 1000000,
            "min_identifier_len": 3,
            "timeout_secs": 30,
            "enabled": true
        },
        "searchfox":
        {
            "bin": "searchfox-cli",
            "default_repo": "mozilla-central",
            "max_depth": 4,
            "timeout_secs": 60,
            "retries": 2,
            "retry_backoff_secs": 1.5,
            "cache_enabled": true
        },
        "llm":
        {
            "principal": {"model": "opus", "effort": "high", "max_turns": 40},
            "roles":
            {
                "crash-interpreter": {"model": "haiku"},
                "call-graph-explorer": {"model": "sonnet", "effort": "high"},
                "patch-scout": {"model": "haiku"},
                "data-flow-tracer": {"model": "sonnet", "effort": "high"},
                "skeptic": {"model": "haiku"}
            },
            "pricing":
            {
                "claude-haiku-4-5": {"in": 1.0, "out": 5.0},
                "claude-sonnet-5": {"in": 3.0, "out": 15.0},
                "claude-opus-4-8": {"in": 5.0, "out": 25.0},
                "claude-fable-5": {"in": 10.0, "out": 50.0}
            },
            "max_cost_usd_per_crash": 2.0
        }
    },
    "eval":
    {
        "corpus_dir": "corpus",
        "max_concurrency": 3,
        "per_case_timeout_s": 900,
        "max_cost_usd_per_case": 3.0,
        "sweep": {},
        "confidence_thresholds": {}
    }
}
