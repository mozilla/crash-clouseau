{
    "products":
    [
        "Firefox"
    ],
    "channels":
    [
        "nightly",
        "beta",
        "release"
    ],
    "facets_limit": 10000,
    "backward_lookup_ndays": 3,
    "max_ndays": 30,
    "score":
    {
        "max": 10,
        "number_of_lines": 5
    },
    "thresholds":
    {
        "installs":
        {
            "Firefox":
            {
                "nightly": 1,
                "beta": 6,
                "release": 50
            }
        },
        "protos":
        {
            "Firefox":
            {
                "nightly": 50,
                "beta": 20,
                "release": 20
            }
        }
    },
    "agent":
    {
        "searchfox":
        {
            "bin": "searchfox-cli",
            "default_repo": "mozilla-central",
            "max_depth": 4,
            "timeout_secs": 60,
            "retries": 2,
            "retry_backoff_secs": 1.5,
            "cache_enabled": true
        }
    }
}
